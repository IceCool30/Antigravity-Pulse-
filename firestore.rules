rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net (blocks all unlisted/unused paths including syncedSessions)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Zero-Trust Reusable Primitives
    function isSignedIn() {
      return request.auth != null &&
             request.auth.uid is string &&
             request.auth.uid.size() > 0 &&
             (!('firebase' in request.auth.token) ||
              request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSafeCloudEndpointUrl(url) {
      return url is string &&
             url.size() >= 8 &&
             url.size() <= 300 &&
             // Strictly http(s)://host[:port][/safe-path] — blocks userinfo (@), query (?), fragment (#),
             // backslashes, whitespace, quotes, angle brackets, and control characters
             url.matches('^https?://[a-zA-Z0-9._:\\[\\]-]+(:[0-9]{1,5})?(/[a-zA-Z0-9._~/%+-]*)?$') &&
             // Block link-local cloud metadata and unspecified addresses
             !url.lower().matches('^https?://(0\\.0\\.0\\.0|169\\.254\\.|\\[?::\\]?|metadata\\.google\\.internal|metadata\\.goog|metadata(/|:|$)).*$');
    }

    function isWithinListLimit() {
      return request.query.limit == null || (request.query.limit >= 1 && request.query.limit <= 100);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Hardened Entity Validation Blueprints
    function isValidCloudServerProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.trim().size() >= 1 && data.name.size() <= 80 &&
             isSafeCloudEndpointUrl(data.endpointUrl) &&
             data.connectionMode is string && (
               data.connectionMode == 'HYBRID_BRIDGE' ||
               data.connectionMode == 'DIRECT_TUNNEL' ||
               data.connectionMode == 'PAIRING_TOKEN'
             ) &&
             // Never allow plaintext workstation auth/bearer tokens in cloud storage
             data.authToken is string && data.authToken.size() == 0 &&
             data.keepAlivePinned is bool &&
             data.lastLatencyMs is int && data.lastLatencyMs >= 0 && data.lastLatencyMs <= 60000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             data.updatedAt >= data.createdAt;
    }

    function isValidCloudCopilotPrompt(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.trim().size() >= 1 && data.title.size() <= 120 &&
             data.promptText is string && data.promptText.trim().size() >= 1 && data.promptText.size() <= 5000 &&
             data.rolePersona is string && data.rolePersona.trim().size() >= 1 && data.rolePersona.size() <= 80 &&
             data.preferredModel is string && data.preferredModel.trim().size() >= 1 && data.preferredModel.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             data.updatedAt >= data.createdAt;
    }

    // 4. Strictly User-Isolated Collections
    match /users/{userId}/serverProfiles/{profileId} {
      allow get: if isOwner(userId) && isValidId(profileId);
      allow list: if isOwner(userId) && isWithinListLimit();

      allow create: if isOwner(userId) &&
                       isValidId(profileId) &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'endpointUrl', 'connectionMode',
                         'authToken', 'keepAlivePinned', 'lastLatencyMs',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'endpointUrl', 'connectionMode',
                         'authToken', 'keepAlivePinned', 'lastLatencyMs',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidCloudServerProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(profileId) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'endpointUrl', 'connectionMode',
                         'authToken', 'keepAlivePinned', 'lastLatencyMs',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidCloudServerProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt >= existing().updatedAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'endpointUrl', 'connectionMode',
                         'authToken', 'keepAlivePinned', 'lastLatencyMs',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(profileId);
    }

    match /users/{userId}/copilotPrompts/{promptId} {
      allow get: if isOwner(userId) && isValidId(promptId);
      allow list: if isOwner(userId) && isWithinListLimit();

      allow create: if isOwner(userId) &&
                       isValidId(promptId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'promptText', 'rolePersona',
                         'preferredModel', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'promptText', 'rolePersona',
                         'preferredModel', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCloudCopilotPrompt(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(promptId) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'promptText', 'rolePersona',
                         'preferredModel', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCloudCopilotPrompt(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt >= existing().updatedAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'promptText', 'rolePersona',
                         'preferredModel', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(promptId);
    }
  }
}
