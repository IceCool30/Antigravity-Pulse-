{
  "entities": {
    "CloudServerProfile": {
      "title": "CloudServerProfile",
      "description": "Synced remote server connection bookmark (auth tokens are strictly stripped and kept local-only).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "Display name for the remote host."
        },
        "endpointUrl": {
          "type": "string",
          "description": "Validated http:// or https:// host URL."
        },
        "connectionMode": {
          "type": "string",
          "enum": ["HYBRID_BRIDGE", "DIRECT_TUNNEL", "PAIRING_TOKEN"],
          "description": "Bridge connection transport mode."
        },
        "authToken": {
          "type": "string",
          "description": "Always empty string in cloud storage for zero-trust security."
        },
        "keepAlivePinned": {
          "type": "boolean",
          "description": "Whether WebView state is pinned in memory."
        },
        "lastLatencyMs": {
          "type": "integer",
          "description": "Last measured latency in milliseconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "name",
        "endpointUrl",
        "connectionMode",
        "authToken",
        "keepAlivePinned",
        "lastLatencyMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudCopilotPrompt": {
      "title": "CloudCopilotPrompt",
      "description": "Saved reusable prompt snippet synced across devices.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Short title of the saved prompt snippet."
        },
        "promptText": {
          "type": "string",
          "description": "Reusable prompt body text."
        },
        "rolePersona": {
          "type": "string",
          "description": "Prompt category label."
        },
        "preferredModel": {
          "type": "string",
          "description": "Optional preset label."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "title",
        "promptText",
        "rolePersona",
        "preferredModel",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/serverProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/CloudServerProfile" },
      "description": "Per-user synced remote host bookmarks."
    },
    "/users/{userId}/copilotPrompts/{promptId}": {
      "schema": { "$ref": "#/entities/CloudCopilotPrompt" },
      "description": "Per-user saved reusable prompt snippets."
    }
  }
}
